{
  "name": "dust-wars",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "Drug Wars",
  "author": "Aleksander.Pavlov <alekseybg@gmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "npm run format:check && npm run lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "check": "npm run lint:check && npm run typecheck && npm test",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "pinia": "^4.0.2",
    "@quasar/extras": "^2.1.0",
    "quasar": "^2.35.1",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "vite-plugin-checker": "^0.14.5",
    "vue-eslint-parser": "^10.4.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "prettier": "^3.8.1",
    "vue-tsc": "^3.3.3",
    "@types/node": "^22.19.11",
    "@quasar/app-vite": "^3.10.2",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "typescript": "^6.0.0"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.15"
  }
}
